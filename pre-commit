#!/bin/bash

# Git pre-commit hook - 테스트 실행
# 이 파일을 .git/hooks/pre-commit로 복사하여 사용하세요

echo "=========================================="
echo "테스트 실행 중..."
echo "=========================================="

# Gradle wrapper를 사용하여 테스트 실행
./gradlew test

# 테스트 결과 확인
if [ $? -ne 0 ]; then
    echo ""
    echo "=========================================="
    echo "❌ 테스트 실패! 커밋이 중단되었습니다."
    echo "=========================================="
    exit 1
fi

echo ""
echo "=========================================="
echo "✅ 모든 테스트 통과! 커밋을 진행합니다."
echo "=========================================="
exit 0

