# Copy this file to .env and replace placeholders with your own values.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
JWT_ISSUER=admin@example.com
JWT_SECRET_KEY=replace-with-a-long-random-signing-key
ADMIN_EMAIL=admin@example.com
S3_BUCKET=your-s3-bucket
OAUTH2_REDIRECT_URI=http://localhost:5173/

# Required by the dev profile database connection.
rds.hostname=your-rds-hostname
rds.port=3306
rds.db.name=your-database-name
rds.driver=com.mysql.cj.jdbc.Driver
rds.username=your-database-username
rds.password=your-database-password
